; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Example_Godot"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"
von/server_path="/Users/athomasson/.venvs/von/bin/von"
debug/command_port=9080

[autoload]

Keybinds="*res://scenes/general/keybinds.gd"
Despawner="*res://scenes/general/despawner.gd"
EventBus="*res://scenes/general/event_bus.gd"
Sound="*res://scenes/audio/sound.gd"

[debug]

file_logging/enable_file_logging=true

[dotnet]

project/assembly_name="Example_Godot"

[editor_plugins]

enabled=PackedStringArray("res://addons/ticket_autorun/plugin.cfg")
